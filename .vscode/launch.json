{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32F446RE - Cortex Debug",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/firmware.elf",

            "servertype": "stlink",
            "interface": "swd",
            "device": "STM32F446RE",

            "gdbPath": "/Users/nilslaeser/Library/Application Support/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "objdumpPath": "/Users/nilslaeser/Library/Application Support/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-objdump",

            "serverpath": "/Users/nilslaeser/Library/Application Support/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver",

            "stm32cubeprogrammer": "/Users/nilslaeser/Library/Application Support/stm32cube/bundles/programmer/2.23.0/bin",

            "runToEntryPoint": "main",
            "showDevDebugOutput": "both"
        }
    ]
